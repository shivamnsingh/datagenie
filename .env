# ── Gemini API ──────────────────────────────────────────────────────────────
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6J594qfWrELcgj0jnRr8qwFLJqT_FrFVQwD2wC7DcCGcA

# Optional — defaults shown below.
# GEMINI_MODEL=gemini-flash-latest
#   ^ auto-updating alias for Google's current GA Flash model. As of
#     July 2026 this points at gemini-3.6-flash. Gemini 2.5 models are no
#     longer available to new API keys/projects — if you see a 404 saying
#     a model "is no longer available to new users", switch away from a
#     hardcoded 2.5-series name. For a pinned, reproducible model instead
#     of the auto-updating alias, use e.g. gemini-3.6-flash or the cheaper
#     gemini-3.5-flash-lite.
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# GEMINI_TIMEOUT_S=30

# Note: setting GEMINI_API_KEY to any value starting with "test_" switches
# GeminiProvider into an offline deterministic fallback mode (no network
# calls) — useful for local dev / CI without real credentials.
