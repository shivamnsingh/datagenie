# ── DataGenie AI — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Required ──────────────────────────────────────────────────────────────────

# Your Gemini API key — used for all LLM calls (Text-to-SQL + RAG answers)
# Set `GEMINI_API_KEY` and optionally `GEMINI_API_URL` if using a custom endpoint.
GEMINI_API_KEY=gmi_your_gemini_key_herE

# ── Optional ──────────────────────────────────────────────────────────────────

# For production semantic embeddings (better RAG quality).
# Uses Anthropic's Voyage AI embedding model.
# Get one at: https://dash.voyageai.com
# If not set, the app uses fast hash-based pseudo-embeddings (fine for dev).
VOYAGE_API_KEY=

# Port overrides (defaults shown)
BACKEND_PORT=8000
FRONTEND_PORT=3000
