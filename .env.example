# ── DataGenie AI — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Required ──────────────────────────────────────────────────────────────────

# Your Anthropic API key — used for Claude (Text-to-SQL + RAG answers)
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Optional ──────────────────────────────────────────────────────────────────

# For production semantic embeddings (better RAG quality).
# Uses Anthropic's Voyage AI embedding model.
# Get one at: https://dash.voyageai.com
# If not set, the app uses fast hash-based pseudo-embeddings (fine for dev).
VOYAGE_API_KEY=

# Port overrides (defaults shown)
BACKEND_PORT=8000
FRONTEND_PORT=3000
